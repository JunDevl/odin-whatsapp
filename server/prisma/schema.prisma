// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(uuid())
  name          String         @unique
  profile_name  String
  email         String         @unique
  password_hash String
  messages      Message[]
  friends       FriendOfUser[] @relation("Friends")
  groups        UserOfGroup[]

  messagesToUser   MessageToUser[]
  originUserFriend FriendOfUser[]
  seenMessages     MessageSeenByUser[]
}

model FriendOfUser {
  originUser   User   @relation(fields: [originUserId], references: [id])
  originUserId String
  friendUser   User   @relation("Friends", fields: [friendUserId], references: [id])
  friendUserId String

  @@id([originUserId, friendUserId])
}

model Group {
  id              String           @id @default(uuid())
  name            String
  description     String?
  // image? Implement this using something better than Prisma/pg (cloud/file based database solutions, such as Supabase, for instance.)
  createdAt       DateTime         @default(now())
  usersOfGroup    UserOfGroup[]
  messagesToGroup MessageToGroup[]
}

model UserOfGroup {
  user     User     @relation(fields: [userId], references: [id])
  userId   String
  group    Group    @relation(fields: [groupId], references: [id])
  groupId  String
  joinedAt DateTime @default(now())

  @@id([userId, groupId])
}

model Message {
  id        String              @id @default(uuid())
  sender    User                @relation(fields: [senderId], references: [id])
  senderId  String
  sentAt    DateTime            @default(now())
  editedAt  DateTime?           @default(now())
  content   String
  deletedAt DateTime?           @default(now())
  seenBy    MessageSeenByUser[]

  messageToGroups MessageToGroup[]
  messageToUsers  MessageToUser[]
}

model MessageSeenByUser {
  message        Message  @relation(fields: [messageId], references: [id])
  messageId      String
  recieverUser   User     @relation(fields: [recieverUserId], references: [id])
  recieverUserId String
  seenAt         DateTime @default(now())

  @@id([messageId, recieverUserId])
}

model MessageToGroup {
  message         Message @relation(fields: [messageId], references: [id])
  messageId       String
  recieverGroup   Group   @relation(fields: [recieverGroupId], references: [id])
  recieverGroupId String

  @@id([messageId, recieverGroupId])
}

model MessageToUser {
  message        Message @relation(fields: [messageId], references: [id])
  messageId      String
  recieverUser   User    @relation(fields: [recieverUserId], references: [id])
  recieverUserId String

  @@id([messageId, recieverUserId])
}
